@{
    ViewData["Title"] = "Chat";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ChatApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="app-shell">

    <!-- Barra lateral: perfil, amigos, notificações, reuniões -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header d-flex align-items-center justify-content-between p-3">
            <div class="d-flex align-items-center gap-2">
                <img id="myPhoto" src="/images/default-avatar.png" class="avatar-sm" />
                <strong id="myName">Eu</strong>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn btn-sm btn-outline-secondary" title="Sair"><i class="bi bi-box-arrow-right"></i></button>
            </form>
        </div>

        <div class="tab-pane-container p-2 borders">
            <!-- Amigos -->
            <div id="tab-friends" class="tab-pane-item">
                <div class="input-group mb-2">
                    <input id="searchInput" class="form-control form-control-sm" placeholder="Pesquisar utilizadores..." />
                    <button id="searchBtn" class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
                </div>
                <div id="searchResults"></div>
                <hr />
                <div id="friendRequests"></div>
                <div id="friendsList" class="list-group"></div>
            </div>

            <!-- Notificações -->
            <div id="tab-notifications" class="tab-pane-item d-none">
                <div id="notificationsList" class="list-group"></div>
            </div>

            <!-- Reuniões -->
            <div id="tab-meetings" class="tab-pane-item d-none">
                <button class="btn btn-sm btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                    <i class="bi bi-camera-video-fill"></i> Nova reunião
                </button>
                <div id="meetingsList" class="list-group"></div>
            </div>

            <!-- Canais -->
            <div id="tab-channel" class="tab-pane-item d-none">
                <div id="channelList" class="list-group"></div>
            </div>
        </div>

        <!-- Navegação principal: sempre visível dentro da sidebar -->
        <div class="icons">
            <ul class="nav nav-tabs" id="sidebarTabs">
                <li class="nav-item"><button class="nav-link active" data-tab="friends" title="Mensagens"><i class="bi bi-chat-quote"></i></button></li>
                <li class="nav-item"><button class="nav-link" data-tab="notifications" title="Notificações">
                    <i class="bi bi-bell"></i> <span id="notifBadge" class="badge bg-danger d-none">0</span></button></li>
                <li class="nav-item"><button class="nav-link" data-tab="meetings" title="Reuniões"><i class="bi bi-people-fill"></i></button></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Channel" title="Canais"><i class="bi bi-broadcast"></i></a>
                </li>
            </ul>
        </div>
    </aside>

    <!-- Área de conversa -->
    <main class="chat-area borders">
        <div id="chatEmpty" class="chat-empty">
            <i class="bi bi-chat-dots display-1 text-muted"></i>
            <p class="text-muted">Selecione um amigo para começar a conversar</p>
        </div>

        <div id="chatWindow" class="chat-window d-none">
            <div class="chat-header d-flex align-items-center justify-content-between p-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <button id="btnBackToList" class="btn btn-sm btn-outline-secondary d-md-none" title="Voltar" type="button">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <img id="chatFriendPhoto" class="avatar-sm" src="/images/default-avatar.png" />
                    <div>
                        <div id="chatFriendName" class="fw-bold"></div>
                        <small id="chatFriendStatus" class="text-muted"></small>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button id="btnAudioCall" class="btn btn-sm btn-outline-success"><i class="bi bi-telephone-fill"></i></button>
                    <button id="btnVideoCall" class="btn btn-sm btn-outline-primary"><i class="bi bi-camera-video-fill"></i></button>
                </div>
            </div>

            <div id="messagesContainer" class="messages-container p-3"></div>

            <div class="chat-input p-2 border-top">
                <div class="d-flex align-items-center gap-20">
                    <label class="btn btn-sm btn-outline-secondary mb-0" title="Enviar ficheiro">
                        <i class="bi bi-paperclip"></i>
                        <input type="file" id="fileInput" class="d-none" />
                    </label>
                    <button id="btnRecordAudio" class="btn btn-sm btn-outline-secondary" title="Gravar áudio">
                        <i class="bi bi-mic-fill"></i>
                    </button>
                    <input id="messageInput" class="form-control" placeholder="Escreva uma mensagem..." autocomplete="off" />
                    <button id="btnSend" class="btn btn-primary"><i class="bi bi-send-fill"></i></button>
                </div>
            </div>
        </div>

    </main>

    <!-- Chamada em curso (overlay) -->
    <div id="callOverlay" class="call-overlay d-none">
        <video id="remoteVideo" autoplay playsinline></video>
        <video id="localVideo" autoplay playsinline muted></video>
        <div class="call-controls">
            <button id="btnToggleMic" class="btn btn-light rounded-circle"><i class="bi bi-mic-fill"></i></button>
            <button id="btnToggleCam" class="btn btn-light rounded-circle"><i class="bi bi-camera-video-fill"></i></button>
            <button id="btnHangup" class="btn btn-danger rounded-circle"><i class="bi bi-telephone-x-fill"></i></button>
        </div>
    </div>

    <!-- Chamada a receber (toast) -->
    <div id="incomingCallToast" class="incoming-call-toast d-none">
        <p id="incomingCallText" class="mb-2"></p>
        <button id="btnAcceptCall" class="btn btn-success btn-sm">Atender</button>
        <button id="btnRejectCall" class="btn btn-danger btn-sm">Rejeitar</button>
    </div>
</div>

<!-- Modal nova reunião -->
<div class="modal fade" id="newMeetingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nova reunião</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input id="meetingTitle" class="form-control mb-2" placeholder="Título da reunião" />
                <label class="form-label small">Início (opcional)</label>
                <input id="meetingStart" type="datetime-local" class="form-control mb-2" />
            </div>
            <div class="modal-footer">
                <button id="btnCreateMeeting" class="btn btn-primary">Criar e entrar</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script src="~/js/chat.js"></script>
<script src="~/js/call.js"></script>
</body>
</html>
