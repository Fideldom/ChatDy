@{
ViewData["Title"] = "Canais";
Layout = null;
}

<!DOCTYPE html>

<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

<title>Canais - ChatApp</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<link rel="stylesheet" href="~/css/channel.css" />

</head>

<body>

<div class="channel-app">

<!--  SIDEBAR -->
<aside class="channel-sidebar">

    <!-- Perfil -->
    <div class="channel-sidebar-header">

        <div class="d-flex align-items-center gap-2">
            <img id="currentUserPhoto"
                 src="/images/default-avatar.png"
                 class="avatar"
                 alt="Perfil" />

            <div>
                <strong id="currentUserName">Eu</strong>
                <small class="d-block text-muted">Canais</small>
            </div>
        </div>

        <a href="/Home/Index"
           class="btn btn-sm btn-outline-secondary"
           title="Voltar para o chat">

            <i class="bi bi-chat-dots"></i>
        </a>

    </div>


    <!-- Pesquisa -->
    <div class="channel-search p-2">

        <div class="input-group">

            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>

            <input id="channelSearchInput"
                   type="text"
                   class="form-control"
                   placeholder="Pesquisar canais..." />

        </div>

    </div>


    <!-- Botão criar -->
    <div class="p-2">

        <button id="btnNewChannel"
                class="btn btn-primary w-100">

            <i class="bi bi-plus-circle me-1"></i>

            Criar canal

        </button>

    </div>


    <!-- Lista -->
    <div class="channel-list-container">

        <div class="px-3 py-2">

            <small class="text-uppercase text-muted fw-bold">
                Meus canais
            </small>

        </div>

        <div id="myChannelsList"
             class="channel-list">

            <!-- preenchido pelo JS -->

        </div>


        <div class="px-3 py-2 mt-2">

            <small class="text-uppercase text-muted fw-bold">
                Descobrir canais
            </small>

        </div>

        <div id="discoverChannelsList"
             class="channel-list">

            <!-- preenchido pelo JS -->

        </div>

    </div>

</aside>


<!-- =========================================================
     ÁREA PRINCIPAL
     ========================================================= -->
<main class="channel-main">

    <!-- Estado vazio -->
    <section id="channelEmpty"
             class="channel-empty">

        <div class="empty-icon">

            <i class="bi bi-broadcast"></i>

        </div>

        <h3>Bem-vindo aos canais</h3>

        <p class="text-muted">
            Selecione um canal para visualizar as publicações.
        </p>

        <button id="btnEmptyCreateChannel"
                class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>

            Criar canal

        </button>

    </section>


    <!-- =====================================================
         CANAL ABERTO
         ===================================================== -->
    <section id="channelView"
             class="channel-view d-none">


        <!-- Header -->
        <header class="channel-header">

            <div class="d-flex align-items-center gap-3">

                <button id="btnMobileBack"
                        class="btn btn-sm btn-outline-secondary d-lg-none">

                    <i class="bi bi-arrow-left"></i>

                </button>


                <img id="channelPhoto"
                     src="/images/default-channel.png"
                     class="channel-avatar"
                     alt="Canal" />


                <div>

                    <h4 id="channelName"
                        class="mb-0">
                        Canal
                    </h4>

                    <small id="channelMembers"
                           class="text-muted">
                        0 membros
                    </small>

                </div>

            </div>


            <div class="d-flex gap-2">

                <button id="btnChannelMembers"
                        class="btn btn-sm btn-outline-secondary"
                        title="Membros">

                    <i class="bi bi-people"></i>

                </button>


                <button id="btnChannelInvite"
                        class="btn btn-sm btn-outline-primary"
                        title="Convidar">

                    <i class="bi bi-person-plus"></i>

                </button>


                <button id="btnChannelSettings"
                        class="btn btn-sm btn-outline-secondary"
                        title="Configurações">

                    <i class="bi bi-three-dots"></i>

                </button>

            </div>

        </header>


        <!-- Descrição -->
        <div class="channel-description">

            <span id="channelDescription">
                Descrição do canal
            </span>

        </div>


        <!-- =================================================
             PUBLICAÇÕES
             ================================================= -->
        <div id="postsContainer"
             class="posts-container">

            <!-- Posts inseridos pelo JS -->

        </div>


        <!-- =================================================
             CRIAR PUBLICAÇÃO
             ================================================= -->
        <div id="createPostBox"
             class="create-post-box">

            <div class="d-flex gap-2">

                <img id="postAuthorPhoto"
                     src="/images/default-avatar.png"
                     class="avatar"
                     alt="Perfil" />


                <div class="post-input-area">

                    <textarea id="postContent"
                              class="form-control"
                              rows="2"
                              placeholder="Publique algo no canal..."></textarea>


                    <div class="post-actions">

                        <div class="d-flex gap-2">

                            <label class="btn btn-sm btn-outline-secondary">

                                <i class="bi bi-image"></i>

                                Foto

                                <input id="postImageInput"
                                       type="file"
                                       accept="image/*"
                                       hidden />

                            </label>


                            <button id="btnPostEmoji"
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary">

                                <i class="bi bi-emoji-smile"></i>

                            </button>

                        </div>


                        <button id="btnPublishPost"
                                class="btn btn-primary btn-sm">

                            <i class="bi bi-send me-1"></i>

                            Publicar

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>


<!-- =========================================================
     MODAL - CRIAR CANAL
     ========================================================= -->
<div class="modal fade"
     id="newChannelModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-broadcast me-2"></i>

                    Criar canal

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <!-- Foto -->
                <div class="text-center mb-3">

                    <label for="newChannelPhoto"
                           class="channel-photo-upload">

                        <img id="newChannelPhotoPreview"
                             src="/images/default-channel.png"
                             alt="Canal" />

                        <span>

                            <i class="bi bi-camera-fill"></i>

                        </span>

                    </label>

                    <input id="newChannelPhoto"
                           type="file"
                           accept="image/*"
                           hidden />

                </div>


                <!-- Nome -->
                <div class="mb-3">

                    <label class="form-label">
                        Nome do canal
                    </label>

                    <input id="newChannelName"
                           type="text"
                           class="form-control"
                           maxlength="100"
                           placeholder="Ex.: Tecnologia Angola" />

                </div>


                <!-- Descrição -->
                <div class="mb-3">

                    <label class="form-label">
                        Descrição
                    </label>

                    <textarea id="newChannelDescription"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              placeholder="Sobre o que é este canal?"></textarea>

                </div>


                <!-- Privacidade -->
                <div class="mb-3">

                    <label class="form-label">
                        Privacidade
                    </label>


                    <div class="privacy-option">

                        <input type="radio"
                               class="form-check-input"
                               name="channelPrivacy"
                               id="channelPublic"
                               value="false"
                               checked />

                        <label for="channelPublic">

                            <strong>
                                <i class="bi bi-globe me-1"></i>
                                Público
                            </strong>

                            <small>
                                Qualquer pessoa pode encontrar o canal.
                            </small>

                        </label>

                    </div>


                    <div class="privacy-option">

                        <input type="radio"
                               class="form-check-input"
                               name="channelPrivacy"
                               id="channelPrivate"
                               value="true" />

                        <label for="channelPrivate">

                            <strong>
                                <i class="bi bi-lock me-1"></i>
                                Privado
                            </strong>

                            <small>
                                Apenas pessoas convidadas podem participar.
                            </small>

                        </label>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button id="btnCreateChannel"
                        type="button"
                        class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>

                    Criar canal

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL - MEMBROS
     ========================================================= -->
<div class="modal fade"
     id="membersModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-people me-2"></i>

                    Membros do canal

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div id="membersList"
                     class="members-list">

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL - CONVIDAR
     ========================================================= -->
<div class="modal fade"
     id="inviteModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-person-plus me-2"></i>

                    Convidar para o canal

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="input-group mb-3">

                    <span class="input-group-text">

                        <i class="bi bi-search"></i>

                    </span>

                    <input id="inviteSearchInput"
                           class="form-control"
                           placeholder="Pesquisar utilizador..." />

                </div>


                <div id="inviteUsersList"
                     class="invite-users-list">

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL - PARTILHAR POST
     ========================================================= -->
<div class="modal fade"
     id="sharePostModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-share me-2"></i>

                    Partilhar publicação

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <textarea id="shareComment"
                          class="form-control"
                          rows="3"
                          placeholder="Adicionar um comentário..."></textarea>

            </div>


            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button id="btnConfirmShare"
                        class="btn btn-primary">

                    <i class="bi bi-share me-1"></i>

                    Partilhar

                </button>

            </div>

        </div>

    </div>

</div>
```

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/channel.js"></script>

</body>
</html>
